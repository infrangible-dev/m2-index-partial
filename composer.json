{
    "name": "infrangible/m2-index-partial",
    "description": "Command-line tools to reindex single products or categories and rebuild their URL rewrites, plus German umlauts written as ae, oe, ue and ss in URLs.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Developer tools",
        "Performance",
        "SEO",
        "reindex single products",
        "regenerate URL rewrites",
        "umlauts in URLs"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-index-partial",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://github.com/infrangible-dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\IndexPartial\\": "src"
        }
    }
}
